# Codex deny rules for local development benches. Copy to .codex/rules/<app>.rules,
# replace myapp, and keep every prefix in step with .claude/settings.json;
# scripts/test_deny_rules.py fails when a prefix here has no Claude rule.

prefix_rule(
    pattern = ["bench", "show-config"],
    decision = "forbidden",
    justification = "Do not disclose site configuration or open a database console. See the agent rules in AGENTS.md.",
    match = ["bench show-config"],
    not_match = ["bench --site myapp-test.localhost migrate"],
)

prefix_rule(
    pattern = ["bench", "mariadb"],
    decision = "forbidden",
    justification = "Do not disclose site configuration or open a database console. See the agent rules in AGENTS.md.",
    match = ["bench mariadb"],
    not_match = ["bench --site myapp-test.localhost migrate"],
)

