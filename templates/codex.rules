    not_match = ["bench --site myapp-test.localhost migrate"],
)

prefix_rule(
    pattern = ["bench", "--site", "myapp-dev.localhost", "drop-site"],
    decision = "forbidden",
    justification = "Never destroy or overwrite the persistent local sites. See the agent rules in AGENTS.md.",
    match = ["bench --site myapp-dev.localhost drop-site"],
    not_match = ["bench --site myapp-scratch.localhost drop-site"],
)

