    justification = "Do not disclose site configuration or open a database console. See the agent rules in AGENTS.md.",
    match = ["bench db-console"],
    not_match = ["bench --site __TEST_SITE__ migrate"],
)

prefix_rule(
    pattern = ["bench", "--site", "__DEV_SITE__", "drop-site"],
    decision = "forbidden",
    justification = "Never destroy or overwrite the persistent local sites. See the agent rules in AGENTS.md.",
    match = ["bench --site __DEV_SITE__ drop-site"],
    not_match = ["bench --site example-scratch.localhost drop-site"],
)

prefix_rule(
    pattern = ["bench", "drop-site", "__DEV_SITE__"],
