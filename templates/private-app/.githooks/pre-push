#!/usr/bin/env bash
# __APP_TITLE__ pre-push safeguard
set -euo pipefail

while read -r local_ref local_oid remote_ref remote_oid; do
  if [[ "$remote_ref" == refs/heads/main ]]; then
    echo "Direct updates to main are blocked. Push a feature branch and use scripts/merge-pr.py." >&2
    exit 1
  fi
done
